	},
	"engines": {
		"node": ">=24 <25"
	},
	"dependencies": {
		"@tanstack/react-query": "5.102.8",
		"next": "16.3.5",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"typescript": "^5.9.0"
	}
}
